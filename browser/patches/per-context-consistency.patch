+  // The language list behind a per-context locale (Playwright's `locale`,
+  // which Juggler sets as the browsing context's languageOverride). Firefox
+  // used the override verbatim, so a context created with "de-DE" sent
+  // "Accept-Language: de-DE" and reported navigator.languages ["de-DE"]. The
+  // launch-wide locale lists the language without the region too
+  // (CamoufoxWindow.sys.mjs): "de-DE" -> "de-DE, de". A list is kept as given.
+  static void ExpandLanguageOverride(const nsACString& aOverride,
+                                     nsACString& aOut);
+
+  // A context's locale, the languageOverride of its top browsing contexts, for
+  // what has no browsing context to carry it: service workers and the requests
+  // of workers. The parent stores it (BrowsingContext::DidSet); empty clears.
+  // Every page of the context sets it again, and a put reaches every process.
+  // Returns whether it changed.
+  static bool SetLocale(uint32_t aId, const nsACString& aLocale) {
+    nsAutoCString stored;
+    if (GetLocale(aId, stored) ? stored.Equals(aLocale) : aLocale.IsEmpty()) {
+      return false;
+    }
+    nsAutoString key;
+    key.AppendPrintf("nav_locale_%u", aId);
+    RoverfoxStorageManager::PutString(key, NS_ConvertUTF8toUTF16(aLocale));
+    return true;
+  }
+
+  static bool GetLocale(uint32_t aId, nsACString& aOut) {
+    nsAutoString locale;
+    if (!RoverfoxStorageManager::GetString("nav_locale_", aId, locale)) {
+      return false;
+    }
+    CopyUTF16toUTF8(locale, aOut);
+    return true;
+  }
+
 };
 
 }  // namespace dom
 }  // namespace mozilla
 
 #endif  // mozilla_dom_NavigatorManager_h
