+/* static */
+bool NavigatorManager::AppVersionFromUserAgent(const nsAString& aUserAgent,
+                                               nsAString& aOut) {
+  constexpr auto kPrefix = u"Mozilla/5.0 ("_ns;
+  if (!StringBeginsWith(aUserAgent, kPrefix)) {
+    return false;
+  }
+  const int32_t close = aUserAgent.FindChar(u')', kPrefix.Length());
+  if (close < 0) {
+    return false;
+  }
+  const nsDependentSubstring block =
+      Substring(aUserAgent, kPrefix.Length(), close - kPrefix.Length());
+
+  nsAutoString kept;
+  for (const auto& token : nsCharSeparatedTokenizer(block, u';').ToRange()) {
+    if (token.IsEmpty() || StringBeginsWith(token, u"rv:"_ns) ||
+        token.EqualsLiteral("Win64") || token.EqualsLiteral("x64") ||
+        token.EqualsLiteral("Mobile") || token.EqualsLiteral("Tablet") ||
+        StringBeginsWith(token, u"Linux "_ns) ||
+        StringBeginsWith(token, u"Intel Mac OS X"_ns)) {
+      continue;
+    }
+    if (!kept.IsEmpty()) {
+      kept.AppendLiteral(u"; ");
+    }
+    if (StringBeginsWith(token, u"Windows"_ns)) {
+      kept.AppendLiteral(u"Windows");
+    } else {
+      kept.Append(token);
+    }
+  }
+  if (kept.IsEmpty()) {
+    return false;
+  }
+  aOut.AssignLiteral(u"5.0 (");
+  aOut.Append(kept);
+  aOut.Append(u')');
+  return true;
+}
+
+/* static */
+void NavigatorManager::ExpandLanguageOverride(const nsACString& aOverride,
+                                              nsACString& aOut) {
+  aOut.Assign(aOverride);
+  if (aOverride.FindChar(',') != kNotFound) {
+    return;
+  }
+  const int32_t dash = aOverride.FindChar('-');
+  if (dash > 0) {
+    aOut.AppendLiteral(", ");
+    aOut.Append(Substring(aOverride, 0, dash));
+  }
+}
+
 }  // namespace dom
 }  // namespace mozilla
