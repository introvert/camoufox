+// Camoufox: whether the code calling into the DOM right now is the driver's
+// own (see IsPopupAllowed below).
+static bool IsDriverScriptedCaller() {
+  JSContext* cx = nsContentUtils::GetCurrentJSContext();
+  return cx && JS::IsScriptedCallerDebuggerCode(cx);
+}
+
 bool BrowsingContext::IsPopupAllowed() {
   for (auto* context = GetCurrentWindowContext(); context;
        context = context->GetParentWindowContext()) {
     if (context->CanShowPopup()) {
       return true;
     }
+    // Camoufox: an explicit driver evaluate opens popups the way handling user
+    // input does, without granting the document a user-gesture activation.
+    // See nsIDocShell::driverPopupsAllowed; the flag is only ever set around a
+    // juggler Runtime.evaluate / Runtime.callFunction. It counts only when the
+    // driver's own code is the one calling: page code the evaluate reaches (a
+    // getter, a Proxy trap, a toJSON) runs while the flag is set too, and must
+    // meet the popup blocker exactly as it would on stock. Driver code is the
+    // only code a Debugger evaluation compiles (Debugger executeInGlobal), and
+    // an eval inside it counts as driver code too.
+    if (BrowsingContext* bc = context->GetBrowsingContext()) {
+      if (nsIDocShell* shell = bc->GetDocShell()) {
+        if (nsDocShell::Cast(shell)->DriverPopupsAllowed() &&
+            IsDriverScriptedCaller()) {
+          return true;
+        }
+      }
+    }
   }
 
   return false;
 }
 
