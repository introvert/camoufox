 void Navigator::GetDoNotTrack(nsAString& aResult) {
+  // Camoufox: navigator.doNotTrack and the DNT header (nsHttpChannel) answer
+  // from the same config value, as they answer from the same pref in Gecko.
+  if (auto value = MaskConfig::GetString("navigator.doNotTrack")) {
+    aResult.Assign(NS_ConvertUTF8toUTF16(value.value()));
+    return;
+  }
   if (StaticPrefs::privacy_donottrackheader_enabled()) {
     aResult.AssignLiteral("1");
   } else {
     aResult.AssignLiteral("unspecified");
   }
 }
 
 bool Navigator::GlobalPrivacyControl() {
+  // Camoufox: the window, workers (WorkerNavigator) and the Sec-GPC header
+  // (nsHttpChannel) all answer from navigator.globalPrivacyControl.
+  if (auto value = MaskConfig::GetBool("navigator.globalPrivacyControl")) {
+    return value.value();
+  }
   bool gpcStatus = StaticPrefs::privacy_globalprivacycontrol_enabled();
   if (!gpcStatus) {
     nsCOMPtr<nsILoadContext> loadContext = do_GetInterface(mWindow);
     gpcStatus = loadContext && loadContext->UsePrivateBrowsing() &&
                 StaticPrefs::privacy_globalprivacycontrol_pbmode_enabled();
   }
