+  return RoverfoxStorageManager::IsSetterOffered(aObj, "scr_dim");
+}
+
+/* static */
+bool ScreenDimensionManager::IsColorDepthFunctionEnabledForWebIDL(
+    JSContext* aCx, JSObject* aObj) {
+  return RoverfoxStorageManager::IsSetterOffered(aObj, "scr_depth");
+}
+
+/* static */
+bool ScreenDimensionManager::IsWindowPositionFunctionEnabledForWebIDL(
+    JSContext* aCx, JSObject* aObj) {
+  return RoverfoxStorageManager::IsSetterOffered(aObj, "win_pos");
+}
+
+}  // namespace dom
+}  // namespace mozilla
diff --git a/dom/base/ScreenDimensionManager.h b/dom/base/ScreenDimensionManager.h
new file mode 100644
--- /dev/null
+++ b/dom/base/ScreenDimensionManager.h
@@ -0,0 +1,123 @@
+/* Camoufox: Per-context screen dimension manager */
+#ifndef mozilla_dom_ScreenDimensionManager_h
+#define mozilla_dom_ScreenDimensionManager_h
+
+#include "RoverfoxStorageManager.h"
+#include "nsString.h"
+
+namespace mozilla {
+namespace dom {
+
+// Per-context screen geometry, keyed by userContextId, stored through
+// RoverfoxStorageManager so the value survives the content-process boundary the
+// same way NavigatorManager's does.
+//
+// Width and height are stored as one pair and gated by one "disabled" flag:
+// setScreenDimensions() takes both at once, so there is no state in which only
+// one of them has been set. colorDepth is independent -- setScreenColorDepth()
+// is a separate call and self-destructs separately.
+class ScreenDimensionManager {
+ public:
+  static void SetDimensions(uint32_t aId, uint32_t aWidth, uint32_t aHeight) {
+    nsAutoString wKey;
+    wKey.AppendPrintf("scr_w_%u", aId);
+    RoverfoxStorageManager::PutUint(wKey, aWidth);
+    nsAutoString hKey;
+    hKey.AppendPrintf("scr_h_%u", aId);
+    RoverfoxStorageManager::PutUint(hKey, aHeight);
+    RoverfoxStorageManager::MarkSetterUsed("scr_dim", aId);
+  }
+
+  static bool GetDimensions(uint32_t aId, uint32_t& aWidth, uint32_t& aHeight) {
+    static RoverfoxStorageManager::Cache<std::pair<uint32_t, uint32_t>> sCache;
+    return RoverfoxStorageManager::ReadCached(
+        sCache, aId,
+        [&]() -> Maybe<std::pair<uint32_t, uint32_t>> {
+          // Both or neither: a half-applied size is a worse lie than no lie
+          // at all, since screen.width and screen.height would come from
+          // different displays.
+          uint32_t width = 0;
+          uint32_t height = 0;
+          if (!RoverfoxStorageManager::GetUint(
+                  RoverfoxStorageManager::ContextKey("scr_w_", aId), width) ||
+              !RoverfoxStorageManager::GetUint(
+                  RoverfoxStorageManager::ContextKey("scr_h_", aId), height) ||
+              !width || !height) {
+            return Nothing();
+          }
+          return Some(std::make_pair(width, height));
+        },
+        [&](const std::pair<uint32_t, uint32_t>& aSize) {
+          aWidth = aSize.first;
+          aHeight = aSize.second;
+        });
+  }
+
+  static void SetColorDepth(uint32_t aId, uint32_t aDepth) {
+    nsAutoString key;
+    key.AppendPrintf("scr_depth_%u", aId);
+    RoverfoxStorageManager::PutUint(key, aDepth);
+    RoverfoxStorageManager::MarkSetterUsed("scr_depth", aId);
+  }
+
+  static bool GetColorDepth(uint32_t aId, uint32_t& aDepth) {
+    static RoverfoxStorageManager::Cache<uint32_t> sCache;
+    uint32_t depth = 0;
+    if (!RoverfoxStorageManager::GetContextUint(sCache, "scr_depth_", aId,
+                                                depth) ||
+        !depth) {
+      return false;
+    }
+    aDepth = depth;
+    return true;
+  }
+
+  // The window's position on that screen (window.screenX/screenY), also as
+  // one pair. Stored as the bits of each signed value: a maximized Windows
+  // window sits at -8, -8.
+  static void SetWindowPosition(uint32_t aId, int32_t aX, int32_t aY) {
+    nsAutoString xKey;
+    xKey.AppendPrintf("win_x_%u", aId);
+    RoverfoxStorageManager::PutUint(xKey, static_cast<uint32_t>(aX));
+    nsAutoString yKey;
+    yKey.AppendPrintf("win_y_%u", aId);
+    RoverfoxStorageManager::PutUint(yKey, static_cast<uint32_t>(aY));
+    RoverfoxStorageManager::MarkSetterUsed("win_pos", aId);
+  }
+
+  static bool GetWindowPosition(uint32_t aId, int32_t& aX, int32_t& aY) {
+    static RoverfoxStorageManager::Cache<std::pair<int32_t, int32_t>> sCache;
+    return RoverfoxStorageManager::ReadCached(
+        sCache, aId,
+        [&]() -> Maybe<std::pair<int32_t, int32_t>> {
+          uint32_t x = 0;
+          uint32_t y = 0;
+          if (!RoverfoxStorageManager::GetUint(
+                  RoverfoxStorageManager::ContextKey("win_x_", aId), x) ||
+              !RoverfoxStorageManager::GetUint(
+                  RoverfoxStorageManager::ContextKey("win_y_", aId), y)) {
+            return Nothing();
+          }
+          return Some(std::make_pair(static_cast<int32_t>(x),
+                                     static_cast<int32_t>(y)));
+        },
+        [&](const std::pair<int32_t, int32_t>& aPosition) {
+          aX = aPosition.first;
+          aY = aPosition.second;
+        });
+  }
+
+  // WebIDL Func= gates. Each returns false once the matching setter has run,
+  // which is what removes the function from the page's view of window.
+  static bool IsDimensionsFunctionEnabledForWebIDL(JSContext* aCx,
+                                                   JSObject* aObj);
+  static bool IsColorDepthFunctionEnabledForWebIDL(JSContext* aCx,
+                                                   JSObject* aObj);
+  static bool IsWindowPositionFunctionEnabledForWebIDL(JSContext* aCx,
+                                                       JSObject* aObj);
+};
+
+}  // namespace dom
+}  // namespace mozilla
+
+#endif  // mozilla_dom_ScreenDimensionManager_h
