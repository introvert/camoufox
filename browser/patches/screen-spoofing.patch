+void nsGlobalWindowInner::SetScreenDimensions(uint32_t width, uint32_t height,
+                                              ErrorResult& aRv) {
+  if (!width || !height) {
+    aRv.ThrowTypeError("Screen dimensions must be non-zero");
+    return;
+  }
+  ScreenDimensionManager::SetDimensions(
+      RoverfoxStorageManager::UserContextId(this), width, height);
+  RoverfoxStorageManager::RemoveSetter("setScreenDimensions");
+}
+
+void nsGlobalWindowInner::SetScreenColorDepth(uint32_t depth,
+                                              ErrorResult& aRv) {
+  if (!depth) {
+    aRv.ThrowTypeError("Screen colour depth must be non-zero");
+    return;
+  }
+  ScreenDimensionManager::SetColorDepth(
+      RoverfoxStorageManager::UserContextId(this), depth);
+  RoverfoxStorageManager::RemoveSetter("setScreenColorDepth");
+}
+
+void nsGlobalWindowInner::SetWindowPosition(int32_t x, int32_t y,
+                                            ErrorResult& aRv) {
+  ScreenDimensionManager::SetWindowPosition(
+      RoverfoxStorageManager::UserContextId(this), x, y);
+  RoverfoxStorageManager::RemoveSetter("setWindowPosition");
+}
