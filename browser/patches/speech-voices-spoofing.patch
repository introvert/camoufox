diff --git a/dom/base/SpeechVoicesManager.cpp b/dom/base/SpeechVoicesManager.cpp
new file mode 100644
--- /dev/null
+++ b/dom/base/SpeechVoicesManager.cpp
@@ -0,0 +1,179 @@
+/* Camoufox: Per-context speech voices manager */
+#include "SpeechVoicesManager.h"
+
+#include "mozilla/Mutex.h"
+#include "MaskConfig.hpp"
+#include "nsEscape.h"
+#include "nsISupportsImpl.h"
+#include "nsRefPtrHashtable.h"
+
+#include <unordered_set>
+
+namespace mozilla {
+namespace dom {
+
+// The list itself lives in RoverfoxStorageManager, which every process reads:
+// a context's documents land in any content process, and only the first one
+// calls the setter. This is each process's parsed copy.
+static mozilla::Mutex sVoicesMutex("SpeechVoicesManager");
+// Each voice's position in the context's list, by name: a Linux list is a
+// speech-dispatcher grid of up to ~15000 voices.
+using VoiceOrder = nsTHashMap<nsStringHashKey, int32_t>;
+static nsTHashMap<nsUint32HashKey, VoiceOrder> sVoicesMap;
+
+static nsString VoiceListKey(uint32_t aId) {
+  nsAutoString key;
+  key.AppendPrintf("spvoices_%u", aId);
+  return key;
+}
+
+namespace {
+// SpeechDispatcherService's voice record, so the table below has its layout.
+class SpoofedSpeechdVoice {
+ public:
+  SpoofedSpeechdVoice(const nsAString& aName, const nsAString& aLanguage)
+      : mName(aName), mLanguage(aLanguage) {}
+  NS_INLINE_DECL_THREADSAFE_REFCOUNTING(SpoofedSpeechdVoice)
+  nsString mName;
+  nsString mLanguage;
+
+ private:
+  ~SpoofedSpeechdVoice() = default;
+};
+}  // namespace
+
+nsTArray<SpeechdVoice> SpeechVoicesManager::SpeechdVoicesInOrder(
+    const std::vector<std::pair<std::string, std::string>>& aVoices) {
+  // SpeechDispatcherService::Setup builds this table in speech-dispatcher's
+  // order and RegisterVoices adds the voices in the table's iteration order,
+  // which is the order getVoices() reports. Same table, same insertions,
+  // same order.
+  nsRefPtrHashtable<nsStringHashKey, SpoofedSpeechdVoice> table;
+  for (const auto& [name, lang] : aVoices) {
+    nsAutoString uri;
+    uri.AssignLiteral("urn:moz-tts:speechd:");
+    nsAutoCString escaped;
+    NS_EscapeURL(name.c_str(), -1,
+                 esc_OnlyNonASCII | esc_Spaces | esc_AlwaysCopy, escaped);
+    uri.Append(NS_ConvertUTF8toUTF16(escaped));
+    uri.AppendLiteral("?");
+    uri.Append(NS_ConvertUTF8toUTF16(lang));
+    table.InsertOrUpdate(uri, MakeRefPtr<SpoofedSpeechdVoice>(
+                                  NS_ConvertUTF8toUTF16(name),
+                                  NS_ConvertUTF8toUTF16(lang)));
+  }
+  nsTArray<SpeechdVoice> voices(table.Count());
+  for (const auto& entry : table) {
+    const RefPtr<SpoofedSpeechdVoice>& voice = entry.GetData();
+    voices.AppendElement(
+        SpeechdVoice{nsString(entry.GetKey()), voice->mName, voice->mLanguage});
+  }
+  return voices;
+}
+
+static VoiceOrder ParseVoices(const nsAString& aVoiceList) {
+  VoiceOrder voices;
+  auto add = [&voices](const nsAString& aName) {
+    if (!voices.Contains(aName)) {
+      voices.InsertOrUpdate(aName, int32_t(voices.Count()));
+    }
+  };
+  // A Linux identity's list is its speech-dispatcher grid, as JSON.
+  if (StringBeginsWith(aVoiceList, u"{"_ns)) {
+    const auto grid = nlohmann::json::parse(
+        NS_ConvertUTF16toUTF8(aVoiceList).get(), nullptr, false);
+    if (auto expanded = MaskConfig::ExpandSpeechdGrid(
+            grid.is_object() ? grid.value("speechd", nlohmann::json())
+                             : nlohmann::json())) {
+      for (const auto& voice :
+           SpeechVoicesManager::SpeechdVoicesInOrder(expanded.value())) {
+        add(voice.mName);
+      }
+    }
+    return voices;
+  }
+  // Otherwise one name per line: names hold commas ("Chinese (Mandarin, latin
+  // as English)").
+  nsAutoString remaining(aVoiceList);
+  while (!remaining.IsEmpty()) {
+    int32_t newline = remaining.FindChar('\n');
+    nsAutoString name;
+    if (newline >= 0) {
+      name = Substring(remaining, 0, newline);
+      remaining = Substring(remaining, newline + 1);
+    } else {
+      name = remaining;
+      remaining.Truncate();
+    }
+    name.Trim(" \t");
+    if (!name.IsEmpty()) {
+      add(name);
+    }
+  }
+  return voices;
+}
+
+void SpeechVoicesManager::SetVoices(uint32_t aUserContextId,
+                                     const nsAString& aVoiceList) {
+  RoverfoxStorageManager::PutString(VoiceListKey(aUserContextId), aVoiceList);
+  MutexAutoLock lock(sVoicesMutex);
+  sVoicesMap.InsertOrUpdate(aUserContextId, ParseVoices(aVoiceList));
+}
+
+// Parses the context's list into this process's copy the first time it is
+// needed. An absent list is not remembered: another process may set it later.
+static bool EnsureVoices(uint32_t aId) {
+  {
+    MutexAutoLock lock(sVoicesMutex);
+    if (sVoicesMap.Contains(aId)) return true;
+  }
+  nsAutoString list;
+  if (!RoverfoxStorageManager::GetString(VoiceListKey(aId), list)) return false;
+  MutexAutoLock lock(sVoicesMutex);
+  sVoicesMap.InsertOrUpdate(aId, ParseVoices(list));
+  return true;
+}
+
+// The registry also holds the voices of "voices:pool" and
+// "voices:pool:speechd", which only a context that lists them sees. Everywhere
+// else the launch's own list, or its speech-dispatcher grid, is the voices.
+static bool IsLaunchVoice(const nsAString& aVoiceName) {
+  static const std::optional<std::unordered_set<std::string>> sLaunch =
+      []() -> std::optional<std::unordered_set<std::string>> {
+    if (!MaskConfig::MVoices("voices:pool") &&
+        !MaskConfig::Find("voices:pool:speechd")) {
+      return std::nullopt;
+    }
+    std::unordered_set<std::string> names;
+    if (auto voices = MaskConfig::MVoices()) {
+      for (const auto& voice : *voices) names.insert(std::get<1>(voice));
+    }
+    if (auto voices = MaskConfig::MSpeechdVoices()) {
+      for (const auto& voice : *voices) names.insert(voice.first);
+    }
+    return names;
+  }();
+  return !sLaunch ||
+         sLaunch->count(NS_ConvertUTF16toUTF8(aVoiceName).get());
+}
+
+int32_t SpeechVoicesManager::VoiceIndex(uint32_t aUserContextId,
+                                        const nsAString& aVoiceName) {
+  if (!EnsureVoices(aUserContextId)) {
+    return IsLaunchVoice(aVoiceName) ? INT32_MAX : -1;
+  }
+  MutexAutoLock lock(sVoicesMutex);
+  return sVoicesMap.Lookup(aUserContextId).Data().MaybeGet(aVoiceName).valueOr(-1);
+}
+
+void SpeechVoicesManager::DisableFunction(uint32_t aId) {
+  RoverfoxStorageManager::MarkSetterUsed("spvoices", aId);
+}
+
+bool SpeechVoicesManager::IsFunctionEnabledForWebIDL(JSContext* aCx,
+                                                      JSObject* aObj) {
+  return RoverfoxStorageManager::IsSetterOffered(aObj, "spvoices");
+}
+
+}  // namespace dom
+}  // namespace mozilla
diff --git a/dom/base/SpeechVoicesManager.h b/dom/base/SpeechVoicesManager.h
new file mode 100644
