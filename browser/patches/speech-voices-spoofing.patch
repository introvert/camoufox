+++ b/dom/base/SpeechVoicesManager.h
@@ -0,0 +1,43 @@
+/* Camoufox: Per-context speech voices manager */
+#ifndef mozilla_dom_SpeechVoicesManager_h
+#define mozilla_dom_SpeechVoicesManager_h
+
+#include "nsString.h"
+#include "nsTHashMap.h"
+#include "nsHashKeys.h"
+#include "nsTArray.h"
+#include "RoverfoxStorageManager.h"
+
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace mozilla {
+namespace dom {
+
+struct SpeechdVoice {
+  nsString mUri;
+  nsString mName;
+  nsString mLanguage;
+};
+
+class SpeechVoicesManager {
+ public:
+  // A speech-dispatcher grid's voices ((name, lang) pairs, from
+  // MaskConfig::ExpandSpeechdGrid) as SpeechDispatcherService registers them,
+  // in the order getVoices() reports.
+  static nsTArray<SpeechdVoice> SpeechdVoicesInOrder(
+      const std::vector<std::pair<std::string, std::string>>& aVoices);
+  static void SetVoices(uint32_t aUserContextId, const nsAString& aVoiceList);
+  // The voice's place in the context's list, INT32_MAX for any launch voice
+  // in a context without one, and -1 for a voice the context does not have.
+  static int32_t VoiceIndex(uint32_t aUserContextId,
+                            const nsAString& aVoiceName);
+  static void DisableFunction(uint32_t aId);
+  static bool IsFunctionEnabledForWebIDL(JSContext* aCx, JSObject* aObj);
+};
+
+}  // namespace dom
+}  // namespace mozilla
+
+#endif  // mozilla_dom_SpeechVoicesManager_h
