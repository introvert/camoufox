   AdvanceQueue();
 }
 
 void SpeechSynthesis::GetVoices(
     nsTArray<RefPtr<SpeechSynthesisVoice> >& aResult) {
   aResult.Clear();
+  // Per-context speech voice filtering
+  const uint32_t speechVoiceCtxId =
+      RoverfoxStorageManager::UserContextId(GetOwnerWindow());
   uint32_t voiceCount = 0;
   nsCOMPtr<nsPIDOMWindowInner> window = GetOwnerWindow();
   nsCOMPtr<nsIDocShell> docShell = window ? window->GetDocShell() : nullptr;
 
   if (nsContentUtils::ShouldResistFingerprinting(docShell,
                                                  RFPTarget::SpeechSynthesis)) {
@@ -248,31 +254,56 @@ void SpeechSynthesis::GetVoices(
   nsresult rv = nsSynthVoiceRegistry::GetInstance()->GetVoiceCount(&voiceCount);
   if (NS_WARN_IF(NS_FAILED(rv))) {
     return;
   }
 
   nsISupports* voiceParent = NS_ISUPPORTS_CAST(nsIObserver*, this);
+  nsTArray<int32_t> orders;
 
   for (uint32_t i = 0; i < voiceCount; i++) {
     nsAutoString uri;
     rv = nsSynthVoiceRegistry::GetInstance()->GetVoice(i, uri);
 
     if (NS_FAILED(rv)) {
       NS_WARNING("Failed to retrieve voice from registry");
       continue;
     }
 
+    // Per-context voices: only the context's, in the order it lists them.
+    nsAutoString voiceName;
+    nsSynthVoiceRegistry::GetInstance()->GetVoiceName(uri, voiceName);
+    const int32_t order = mozilla::dom::SpeechVoicesManager::VoiceIndex(
+        speechVoiceCtxId, voiceName);
+    if (order < 0) {
+      continue;
+    }
+
     SpeechSynthesisVoice* voice = mVoiceCache.GetWeak(uri);
 
     if (!voice) {
       voice = new SpeechSynthesisVoice(voiceParent, uri);
     }
 
     aResult.AppendElement(voice);
+    orders.AppendElement(order);
   }
 
+  // Stable, so voices of equal order keep the registry's. A Linux list is a
+  // speech-dispatcher grid of up to ~15000 voices.
+  nsTArray<size_t> byOrder(aResult.Length());
+  for (size_t i = 0; i < aResult.Length(); i++) {
+    byOrder.AppendElement(i);
+  }
+  std::stable_sort(byOrder.begin(), byOrder.end(),
+                   [&](size_t a, size_t b) { return orders[a] < orders[b]; });
+  nsTArray<RefPtr<SpeechSynthesisVoice>> sorted(aResult.Length());
+  for (size_t i : byOrder) {
+    sorted.AppendElement(aResult[i]);
+  }
+  aResult = std::move(sorted);
+
   mVoiceCache.Clear();
 
   for (uint32_t i = 0; i < aResult.Length(); i++) {
     SpeechSynthesisVoice* voice = aResult[i];
     mVoiceCache.InsertOrUpdate(voice->mUri, RefPtr{voice});
   }
