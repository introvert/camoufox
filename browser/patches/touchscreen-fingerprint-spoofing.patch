diff --git a/dom/base/Navigator.cpp b/dom/base/Navigator.cpp
index a68a8a9938..97a57fa663 100644
--- a/dom/base/Navigator.cpp
+++ b/dom/base/Navigator.cpp
@@ -1017,6 +1017,39 @@ uint32_t Navigator::MaxTouchPoints(CallerType aCallerType) {
   nsIDocShell* docshell = GetDocShell();
   BrowsingContext* bc = docshell ? docshell->GetBrowsingContext() : nullptr;
 
+  // A context that asked for touch (Playwright's hasTouch) has to report a
+  // digitizer: touch events next to maxTouchPoints == 0 contradict each other.
+  const bool touchContext =
+      bc && bc->TouchEventsOverride() ==
+                mozilla::dom::TouchEventsOverride::Enabled;
+
+  // Allow spoofing navigator.maxTouchPoints via config. A headless build has
+  // no digitizer, so the real value is 0 and Firefox's RFP path only ever
+  // collapses it to 0. The target is not a phone: it is the ordinary Windows
+  // touchscreen laptop, which reports a digitizer here while keeping a fine
+  // primary pointer. See force-default-pointer.patch for the matching
+  // `any-pointer: coarse` half. Stock Firefox's baseline fingerprinting
+  // protection collapses the spoofed count as it would the real one.
+  //
+  // A touch context or mobile mode without a count of its own reports the five
+  // touch points Firefox for Android reports on ordinary phones.
+  std::optional<uint32_t> value =
+      MaskConfig::GetUint32("navigator.maxTouchPoints");
+  if (value && value.value() == 0 && touchContext) {
+    value.reset();
+  }
+  if (!value && (touchContext || MaskConfig::GetBool("mobile"))) {
+    value = 5;
+  }
+  if (value) {
+    if (aCallerType != CallerType::System &&
+        nsContentUtils::ShouldResistFingerprinting(
+            GetDocShell(), RFPTarget::MaxTouchPointsCollapse)) {
+      return nsRFPService::CollapseMaxTouchPoints(value.value());
+    }
+    return value.value();
+  }
+
   // Responsive Design Mode overrides the maxTouchPoints property when
   // touch simulation is enabled.
   if (bc && bc->Top()->InRDMPane()) {
