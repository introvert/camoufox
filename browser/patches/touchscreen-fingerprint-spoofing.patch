+    // Matching that shape matters more than exposing the whole touch API.
+    // Mobile mode, above and in LegacyAPIEnabled, is the Android shape.
+    enabled = maxTouchPoints.value() > 0;
   } else if (nsContentUtils::ShouldResistFingerprinting(
                  aDocShell, RFPTarget::PointerEvents)) {
 #ifdef MOZ_WIDGET_COCOA
