+// The identity's voices, registered as the OS backend it claims would register
+// them, then the pool a context's list may also name, which only that context
+// sees (SpeechVoicesManager). A spoofed voice has no service (SpeakImpl speaks
+// it silently).
+void nsSynthVoiceRegistry::AddSpoofedVoices() {
+  auto addSpeechd =
+      [this](const std::vector<std::pair<std::string, std::string>>& aVoices) {
+        for (const auto& voice :
+             SpeechVoicesManager::SpeechdVoicesInOrder(aVoices)) {
+          if (mUriVoiceMap.Contains(voice.mUri)) {
+            continue;
+          }
+          // As RegisterVoices does: local only for a voice named "default".
+          AddVoiceImpl(nullptr, voice.mUri, voice.mName, voice.mLanguage,
+                       voice.mName.EqualsLiteral("default"), true);
+        }
+      };
+  auto addVoices = [this](const char* aKey) {
+    auto voices = MaskConfig::MVoices(aKey);
+    if (!voices) {
+      return;
+    }
+    for (const auto& [lang, name, uri, isDefault, isLocal] : voices.value()) {
+      const NS_ConvertUTF8toUTF16 voiceUri(uri);
+      if (mUriVoiceMap.Contains(voiceUri)) {
+        continue;
+      }
+      // SAPI voices queue their utterances and macOS's do not, as each
+      // backend registers them.
+      const bool queues = StringBeginsWith(voiceUri, u"urn:moz-tts:sapi:"_ns);
+      AddVoiceImpl(nullptr, voiceUri, NS_ConvertUTF8toUTF16(name),
+                   NS_ConvertUTF8toUTF16(lang), isLocal, queues);
+      if (isDefault) {
+        SetDefaultVoice(voiceUri, true);
+      }
+    }
+  };
+
+  if (auto speechd = MaskConfig::MSpeechdVoices()) {
+    addSpeechd(speechd.value());
+  } else {
+    addVoices("voices");
+  }
+  addVoices("voices:pool");
+  if (const auto* grids = MaskConfig::Find("voices:pool:speechd")) {
+    for (const auto& grid : *grids) {
+      auto voices = MaskConfig::ExpandSpeechdGrid(grid);
+      if (!voices) {
+        printf_stderr("ERROR: a 'voices:pool:speechd' grid is malformed: %s\n",
+                      grid.dump().c_str());
+        continue;
+      }
+      addSpeechd(voices.value());
+    }
+  }
+}
