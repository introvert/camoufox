+uint32_t ClientWebGLContext::GetUserContextId() const {
+  if (mCanvasElement) {
+    return dom::RoverfoxStorageManager::UserContextId(mCanvasElement);
+  }
+  if (mOffscreenCanvas) {
+    nsCOMPtr<nsPIDOMWindowInner> win =
+        do_QueryInterface(mOffscreenCanvas->GetParentObject());
+    if (win) {
+      return dom::RoverfoxStorageManager::UserContextId(win);
+    }
+    if (dom::WorkerPrivate* wp = dom::GetCurrentThreadWorkerPrivate()) {
+      return wp->GetOriginAttributes().mUserContextId;
+    }
+  }
+  return 0;
+}
+
+// Camoufox: the webGl:* / webGl2:* tables this context answers from: its
+// browsing context's own GPU (setWebGLConfig), else the launch's.
+class CamouWebGLTables final {
+ public:
+  explicit CamouWebGLTables(uint32_t aUserContextId)
+      : mOwn(Parsed(aUserContextId)) {}
+  const nlohmann::json& operator*() const {
+    return mOwn ? mOwn->data : MaskConfig::GetJson();
+  }
+  const nlohmann::json* FindGLParam(uint32_t aPname, bool aIsWebGL2) const {
+    return mOwn ? mOwn->FindGLParam(aPname, aIsWebGL2)
+                : MaskConfig::FindGLParam(aPname, aIsWebGL2);
+  }
+
+ private:
+  // Parsed once per thread, context and storage generation: getParameter()
+  // reads it on every call, from windows and from workers' OffscreenCanvas.
+  // Per thread, because a lock and a shared map cost every call more than the
+  // lookup itself; a process rarely serves more contexts than the memo holds.
+  static std::shared_ptr<const MaskConfig::WebGLTables> Parsed(uint32_t aId) {
+    struct Memo {
+      uint32_t mId = 0;
+      uint64_t mGeneration = 0;  // Generation() starts at 1
+      std::shared_ptr<const MaskConfig::WebGLTables> mTables;
+    };
+    static thread_local std::array<Memo, 4> tMemo;
+    static thread_local size_t tNext = 0;
+
+    const uint64_t generation = dom::RoverfoxStorageManager::Generation();
+    for (const Memo& memo : tMemo) {
+      if (memo.mGeneration == generation && memo.mId == aId) {
+        return memo.mTables;
+      }
+    }
+    std::shared_ptr<const MaskConfig::WebGLTables> tables;
+    nsAutoString stored;
+    if (dom::WebGLParamsManager::GetConfig(aId, stored)) {
+      auto parsed = nlohmann::json::parse(
+          NS_ConvertUTF16toUTF8(stored).get(), nullptr, false);
+      if (parsed.is_object()) {
+        tables = std::make_shared<const MaskConfig::WebGLTables>(
+            std::move(parsed));
+      }
+    }
+    tMemo[tNext++ % tMemo.size()] = Memo{aId, generation, tables};
+    return tables;
+  }
+
+  std::shared_ptr<const MaskConfig::WebGLTables> mOwn;
+};
