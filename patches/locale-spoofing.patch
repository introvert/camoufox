 #include "unicode/uloc.h"
 #include "unicode/utypes.h"
+#include "MaskConfig.hpp"
 
 namespace mozilla::intl {
 
 using namespace intl::LanguageTagLimits;
 
+
+// Helper methods for header file
+
+// The config never changes within a process, so each value is read once into
+// a function-local static (thread-safe to initialise) and the returned
+// pointer stays valid. Returning c_str() of MaskConfig's temporary would hand
+// back freed memory.
+static const char* CStrOrNull(const std::optional<std::string>& aValue) {
+  return aValue ? aValue->c_str() : nullptr;
+}
+
+const char* Locale::GetCamouLanguage() {
+  static const std::optional<std::string> sLanguage =
+      MaskConfig::GetString("locale:language");
+  return CStrOrNull(sLanguage);
+}
+
+const char* Locale::GetCamouRegion() {
+  static const std::optional<std::string> sRegion =
+      MaskConfig::GetString("locale:region");
+  return CStrOrNull(sRegion);
+}
+
+const char* Locale::GetCamouScript() {
+  static const std::optional<std::string> sScript =
+      MaskConfig::GetString("locale:script");
+  return CStrOrNull(sScript);
+}
+
+// Publicly exposed methods
+
+const char* Locale::GetCamouLocale() {
+  static const std::optional<std::string> sLocale =
+      []() -> std::optional<std::string> {
+    if (auto value = MaskConfig::GetString("navigator.language")) {
+      return value;
+    }
+    auto lang = MaskConfig::GetString("locale:language");
+    auto region = MaskConfig::GetString("locale:region");
+    if (lang && region) {
+      return lang.value() + "-" + region.value();
+    }
+    return std::nullopt;
+  }();
+  return CStrOrNull(sLocale);
+}
+
+const char* Locale::GetDefaultLocale() {
+  // In Camoufox, GetDefaultLocale is defined outside the header
+  // to access MaskConfig.
+  if (auto value = GetCamouLocale())
+    return value;
+  return uloc_getDefault();
+}
