+// Camoufox: the spoofed User-Agent, or null without one. CAMOU_CONFIG never
+// changes, so it is read once into a string that is never written again.
+// UserAgent() runs off the main thread too (proxy CONNECT requests), and
+// re-assigning the shared mUserAgent there on every call was a data race.
+static const nsCString* MaskedUserAgent() {
+  static const nsCString* const sMasked = []() -> const nsCString* {
+    for (const char* key : {"headers.User-Agent", "navigator.userAgent"}) {
+      if (auto value = MaskConfig::GetString(key)) {
+        return new nsCString(value.value().c_str());  // intentionally leaked
+      }
+    }
+    return nullptr;
+  }();
+  return sMasked;
+}
