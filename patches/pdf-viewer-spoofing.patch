 bool Navigator::PdfViewerEnabled() {
+  // Camoufox: pdfViewerEnabled decides the whole PDF surface -- this flag and
+  // the spec's hard-coded plugins/mimeTypes (nsPluginArray, nsMimeTypeArray)
+  // -- so the three can never disagree.
+  if (auto value = MaskConfig::GetBool("pdfViewerEnabled")) {
+    return value.value();
+  }
   return !StaticPrefs::pdfjs_disabled() ||
          nsContentUtils::ShouldResistFingerprinting(GetDocShell(),
                                                     RFPTarget::PdfjsSpoof);
 }
 
 Permissions* Navigator::GetPermissions(ErrorResult& aRv) {
