-// The JSON object holding this context's WebGL persona ("webGl:..." keys).
-static const nlohmann::json& MaskRootFor(
-    [[maybe_unused]] uint32_t aUserContextId) {
-  return MaskConfig::GetJson();
+// The JSON object holding this context's WebGL persona ("webGl:..." keys):
+// the record window.setWebGLParameters() stored for its user context, else
+// the launch-wide CAMOU_CONFIG.
+//
+// Each record is parsed once per process and kept for the process lifetime,
+// and a user context without one is remembered too: getParameter() runs in
+// render loops, and the storage read behind a miss can be a sync IPC. The
+// setter runs from the context's init script, before any page script can
+// create a WebGL context, so a miss is not cached ahead of its record.
+static const nlohmann::json& MaskRootFor(uint32_t aUserContextId) {
+  static StaticMutex sMutex MOZ_UNANNOTATED;
+  // Intentionally leaked: references into it are handed out.
+  static auto* sRecords =
+      new std::unordered_map<uint32_t, std::unique_ptr<nlohmann::json>>();
+  {
+    StaticMutexAutoLock lock(sMutex);
+    auto found = sRecords->find(aUserContextId);
+    if (found != sRecords->end()) {
+      return found->second ? *found->second : MaskConfig::GetJson();
+    }
+  }
+
+  std::unique_ptr<nlohmann::json> record;
+  nsAutoString stored;
+  if (WebGLParamsManager::GetParameters(aUserContextId, stored)) {
+    NS_ConvertUTF16toUTF8 utf8(stored);
+    std::string_view text(utf8.get(), utf8.Length());
+    if (nlohmann::json::accept(text)) {
+      auto parsed = nlohmann::json::parse(text);
+      if (parsed.is_object()) {
+        record = std::make_unique<nlohmann::json>(std::move(parsed));
+      }
+    } else {
+      printf_stderr("ERROR: invalid JSON passed to setWebGLParameters\n");
+    }
+  }
+
+  StaticMutexAutoLock lock(sMutex);
+  auto [entry, inserted] =
+      sRecords->try_emplace(aUserContextId, std::move(record));
+  return entry->second ? *entry->second : MaskConfig::GetJson();
 }
 
