+    // that is missing. WebGL context creation then fails outright and
+    // canvas.getContext('webgl') hands the page a null.
+    //
+    // A browser that claims a GPU in every other signal and has no WebGL at all
+    // is a louder tell than any renderer string, so ask for the EGL provider
+    // directly. It reaches Mesa's swrast device, or EGL_PLATFORM_SURFACELESS_MESA
+    // where there is no render node, and either gives a real GL ES context on
+    // llvmpipe with no X server and no hardware. Headful is untouched.
+    if (gfxPlatform::IsHeadless() || IsWaylandDisplay() ||
+        gfxConfig::IsEnabled(Feature::X11_EGL)) {
       gfxVars::SetUseEGL(true);
     }
     InitDmabufConfig();
