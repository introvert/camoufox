diff --git a/gfx/thebes/gfxPlatform.cpp b/gfx/thebes/gfxPlatform.cpp
index f45971a4ec..b6e95c41a4 100644
--- a/gfx/thebes/gfxPlatform.cpp
+++ b/gfx/thebes/gfxPlatform.cpp
@@ -3216,6 +3216,16 @@ void gfxPlatform::InitWebGLConfig() {
     if (StaticPrefs::webgl_ignore_blocklist_AtStartup()) {
       featureWebGL.UserForceEnable(
           "Ignoring blocklist entry because webgl.ignore-blocklist is true.");
+    } else if (IsHeadless()) {
+      // Camoufox: headless leaves gfxInfo with nothing to go on -- the glxtest
+      // probe opens an X connection before anything else and cannot reach one,
+      // so it fails and GfxInfo blocks most features by default. This says
+      // blocklisted for want of a display, not for want of a driver. Note the
+      // ordering: Disable() below writes the environment status, and SetUser()
+      // asserts that has not happened yet, which is why the force-enable goes
+      // here rather than after.
+      featureWebGL.UserForceEnable(
+          "Camoufox: headless, gfxInfo had no display to probe");
     }
     featureWebGL.Disable(FeatureStatus::Blocklisted, message.get(), failureId);
   }
@@ -3230,6 +3240,22 @@ void gfxPlatform::InitWebGLConfig() {
   gfxVars::SetAllowMetalAngleWebGL(
       IsFeatureOk(nsIGfxInfo::FEATURE_WEBGL_ANGLE_METAL));
 
+  // Camoufox: same reasoning as the force-enable above, for the two vars that
+  // actually gate context creation. WebglAllowWindowsNativeGl is what
+  // WebGLContext.cpp checks before it will try native GL at all, and a headless
+  // process fails that check for want of a display rather than for want of a
+  // driver. Whether WebGL exists belongs to the fingerprint, not to the host's
+  // window system.
+  //
+  // WebglUseHardware stays false on purpose: nothing is accelerating a headless
+  // process, and false is what sends DefaultEglDisplay() to the swrast device
+  // before anything else.
+  if (IsHeadless()) {
+    gfxVars::SetAllowWebgl2(true);
+    gfxVars::SetWebglAllowWindowsNativeGl(true);
+    gfxVars::SetWebglUseHardware(false);
+  }
+
   if (kIsMacOS) {
