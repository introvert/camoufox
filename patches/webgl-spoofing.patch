+uint32_t ClientWebGLContext::GetUserContextId() const {
+  if (mCanvasElement) {
+    if (Document* doc = mCanvasElement->OwnerDoc()) {
+      if (BrowsingContext* bc = doc->GetBrowsingContext()) {
+        return bc->OriginAttributesRef().mUserContextId;
+      }
+    }
+  } else if (mOffscreenCanvas) {
+    if (nsIGlobalObject* global = mOffscreenCanvas->GetParentObject()) {
+      nsCOMPtr<nsPIDOMWindowInner> win = do_QueryInterface(global);
+      if (win) {
+        if (BrowsingContext* bc = win->GetBrowsingContext()) {
+          return bc->OriginAttributesRef().mUserContextId;
+        }
+      } else if (WorkerPrivate* wp = GetCurrentThreadWorkerPrivate()) {
+        return wp->GetOriginAttributes().mUserContextId;
+      }
+    }
+  }
+  return 0;
+}
+
+// The JSON object holding this context's WebGL persona ("webGl:..." keys).
+static const nlohmann::json& MaskRootFor(
+    [[maybe_unused]] uint32_t aUserContextId) {
+  return MaskConfig::GetJson();
+}
+
+std::optional<std::string> ClientWebGLContext::SpoofedRenderer() const {
+  nsAutoString stored;
+  if (WebGLParamsManager::GetRenderer(GetUserContextId(), stored)) {
+    return std::string(NS_ConvertUTF16toUTF8(stored).get());
+  }
+  return MaskConfig::GetStringIn(MaskRootFor(GetUserContextId()),
+                                 "webGl:renderer");
+}
+
+std::optional<std::string> ClientWebGLContext::SpoofedVendor() const {
+  nsAutoString stored;
+  if (WebGLParamsManager::GetVendor(GetUserContextId(), stored)) {
+    return std::string(NS_ConvertUTF16toUTF8(stored).get());
+  }
+  return MaskConfig::GetStringIn(MaskRootFor(GetUserContextId()),
+                                 "webGl:vendor");
+}
